{
  "name": "@ctulhu-vpn/routing-rules",
  "version": "1.1.0",
  "description": "Versioned routing-rule artifacts for Ctulhu VPN clients",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "style": "prettier . --write",
    "setup:mihomo": "node scripts/install-mihomo.mjs",
